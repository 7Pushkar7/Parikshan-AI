# ---- Required ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- LLM ----
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite   # used automatically if the main model is busy (503) or rate-limited (429)
GEMINI_TIER=free            # free = billed $0 (UI shows paid-tier equivalent), paid = pay-as-you-go
TEMPERATURE=0.1             # used for gemini-2.x only; Gemini 3 keeps its default 1.0
# THINKING_BUDGET=1024      # optional, Gemini 2.5 models only: cap on thinking tokens (billed as output)
# PRICE_INPUT_PER_M=0.75    # optional manual price override, USD per 1M tokens
# PRICE_OUTPUT_PER_M=3.75
USD_TO_INR=84

# ---- Agent ----
MAX_AGENT_STEPS=12
HISTORY_MESSAGES_KEPT=30

# ---- External APIs (all optional) ----
# NCBI_API_KEY=             # raises PubMed limit from 3 to 10 requests/second
NCBI_EMAIL=you@example.com

# ---- RAG ----
EMBEDDINGS=local            # local = free on-device MiniLM model, gemini = Gemini embedding API
RAG_TOP_K=12
